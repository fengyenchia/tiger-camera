# Local environment files anywhere in the repository
**/.env
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production
**/.env.test
!**/.env.example

# Private keys and certificates
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer

# Local API clients and provisioning exports
**/*.postman_environment.json
**/postman/*.environment.json
firmware/**/include/credentials.h
firmware/**/data/device.json
firmware/**/data/provisioning.json
firmware/**/*.nvs.bin

# PlatformIO build output and editor state
firmware/**/.pio/
firmware/**/.vscode/

# Device-local network and API credentials
firmware/**/include/secrets.h
firmware/**/secrets.h

# 忽略所有 reference-images 資料夾
**/reference-images/

# 忽略所有 .md 檔案
*.md
**/*.md
S
# 保留根目錄的 README.md
!/README.md